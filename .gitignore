Properties/launchSettings.json
*.pubxml.user

# Rider / VS Code
.idea/
.vscode/
*.DotSettings.user

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json

# Test and diagnostics output
TestResults/
*.log
*.binlog
*.dmp
*.etl

# Code-signing keys: never commit them
*.pfx
*.p12
*.snk

# Leftovers from editors and merges
*.bak
*.tmp
*.orig

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
