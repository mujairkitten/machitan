<Window
    x:Class="Machitan.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machitan"
    Title="Machitan">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="PillBorder"
                CornerRadius="20"
                BorderThickness="1"
                BorderBrush="{ThemeResource BarPillStroke}"
                Background="Transparent">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Task Manager" Click="TaskManager_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Taskbar settings" Click="SettingsButton_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit Machitan" Click="Exit_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>
            <Grid Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: start + search -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Button x:Name="StartButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Width="44"
                            Height="44"
                            Click="StartButton_Click"
                            ToolTipService.ToolTip="Start">
                        <FontIcon Glyph="&#xE700;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="18"
                                  Foreground="{ThemeResource BarAccent}" />
                    </Button>

                    <Border x:Name="SearchBorder"
                            Width="230"
                            Height="36"
                            CornerRadius="18"
                            Background="{ThemeResource BarSearchFill}"
                            BorderBrush="{ThemeResource BarSearchStroke}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            PointerPressed="SearchBorder_PointerPressed">
                        <Grid VerticalAlignment="Center" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE721;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="13"
                                      Foreground="{ThemeResource BarTextSecondary}"
                                      Margin="12,0,6,0"
                                      VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{ThemeResource BarTextPrimary}"
                                     PlaceholderText="Search"
                                     PlaceholderForeground="{ThemeResource BarTextTertiary}"
                                     FontSize="12"
                                     Padding="0,0,12,0"
                                     Margin="0"
                                     MinHeight="0"
                                     Height="32"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchBox_KeyDown">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Center: running apps -->
                <ItemsRepeater x:Name="TaskRepeater"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:TaskWindowItem">
                            <Button Style="{StaticResource BarTaskButtonStyle}"
                                    Width="{x:Bind local:MainWindow.GetTaskButtonWidth(), Mode=OneTime}"
                                    Height="{x:Bind local:MainWindow.GetTaskButtonHeight(), Mode=OneTime}"
                                    DataContext="{x:Bind}"
                                    Click="TaskButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                <Grid Width="{x:Bind local:MainWindow.GetTaskButtonWidth(), Mode=OneTime}"
                                      Height="{x:Bind local:MainWindow.GetTaskButtonHeight(), Mode=OneTime}">
                                    <Image Source="{x:Bind IconSource, Mode=OneWay}"
                                           Width="{x:Bind local:MainWindow.GetTaskIconSize(), Mode=OneTime}"
                                           Height="{x:Bind local:MainWindow.GetTaskIconSize(), Mode=OneTime}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-4,0,0" />
                                    <Border Width="16"
                                            Height="3"
                                            CornerRadius="1.5"
                                            Background="{ThemeResource BarAccent}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,4"
                                            Visibility="{x:Bind local:BoolToVisibilityConverter.ToVis(IsActive), Mode=OneWay}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Right: weather, clock, tray -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <!-- Weather: hidden for V1 (out of scope) -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE753;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="16"
                                  Foreground="{ThemeResource BarAccent}"
                                  VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WeatherText"
                                       Text="72°F"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource BarTextPrimary}" />
                            <TextBlock x:Name="WeatherConditionText"
                                       Text="Sunny"
                                       FontSize="10"
                                       Foreground="{ThemeResource BarTextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Width="1"
                               Height="20"
                               Fill="{ThemeResource BarDivider}"
                               Margin="4,0" />

                    <Button x:Name="ClockButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Width="88"
                            Click="Calendar_Click"
                            ToolTipService.ToolTip="Calendar">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText"
                                       Text="--:--"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource BarTextPrimary}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="DateText"
                                       Text="--- --/--"
                                       FontSize="10"
                                       Foreground="{ThemeResource BarTextSecondary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NotificationButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            ToolTipService.ToolTip="Notifications">
                        <FontIcon Glyph="&#xE7E7;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="16"
                                  Foreground="{ThemeResource BarTextSecondary}" />
                    </Button>

                    <Button x:Name="QuickSettingsButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Click="QuickSettings_Click"
                            ToolTipService.ToolTip="Quick settings">
                        <FontIcon Glyph="&#xE701;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="16"
                                  Foreground="{ThemeResource BarTextSecondary}" />
                    </Button>

                    <Button x:Name="SettingsButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Click="SettingsButton_Click"
                            ToolTipService.ToolTip="Machitan settings">
                        <FontIcon Glyph="&#xE713;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="16"
                                  Foreground="{ThemeResource BarTextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
