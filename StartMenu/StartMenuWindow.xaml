<Window
    x:Class="Machitan.StartMenu.StartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machitan.StartMenu"
    Title="Start">

    <Grid x:Name="RootGrid" Background="Transparent">

        <Border x:Name="GlassBorder"
                CornerRadius="20"
                Background="{ThemeResource StartPaneFill}"
                BorderBrush="{ThemeResource StartPaneStroke}"
                BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" Padding="20">
                <Border Grid.Column="0" Width="52" Background="Transparent">
                    <StackPanel VerticalAlignment="Center" Spacing="16" Margin="0,24,0,24">
                        <Button x:Name="StartNavButton"
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource StartNavButtonBackground}"
                                CornerRadius="10"
                                Padding="0"
                                Click="StartNavButton_Click"
                                ToolTipService.ToolTip="Start">
                            <FontIcon Glyph="&#xE700;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="16"
                                      Foreground="{ThemeResource StartNavIconFill}" />
                        </Button>

                        <Button x:Name="AllAppsNavButton"
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="0"
                                Click="AllAppsNavButton_Click"
                                ToolTipService.ToolTip="All apps">
                            <FontIcon Glyph="&#xE71D;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="14"
                                      Foreground="{ThemeResource StartNavIconFill}" />
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" Margin="0,16,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="10"
                                    Background="{ThemeResource BarAvatarFill}">
                                <TextBlock x:Name="AvatarInitial"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="UserNameText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource BarTextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="280"
                                Height="36"
                                CornerRadius="18"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{ThemeResource BarSearchFill}"
                                BorderBrush="{ThemeResource BarSearchStroke}"
                                BorderThickness="1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE721;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="13"
                                          Foreground="{ThemeResource BarTextSecondary}"
                                          Margin="10,0,6,0"
                                          VerticalAlignment="Center" />
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{ThemeResource BarTextPrimary}"
                                         PlaceholderText="Search apps"
                                         PlaceholderForeground="{ThemeResource BarTextTertiary}"
                                         FontSize="12"
                                         Padding="0,0,8,0"
                                         MinHeight="0"
                                         Height="32"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"
                                         KeyDown="SearchBox_KeyDown">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Recently used -->
                        <Grid x:Name="RecentlyUsedGrid" Grid.Row="0" Margin="20,8,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Recently used"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource BarTextSecondary}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ItemsRepeater x:Name="RecentlyUsedRepeater" Grid.Row="0" Margin="0,0,0,12">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="72"
                                                   MinItemHeight="88"
                                                   ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:PinnedApp">
                                    <Button Style="{StaticResource RecentAppButtonStyle}"
                                            Width="72"
                                            Height="88"
                                            DataContext="{x:Bind}"
                                            Click="RecentTile_Click"
                                            RightTapped="Recent_RightTapped"
                                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                        <StackPanel Spacing="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Image Source="{x:Bind IconSource, Mode=OneWay}"
                                                   Width="28"
                                                   Height="28"
                                                   HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource BarTextPrimary}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Pinned section -->
                        <Grid x:Name="PinnedFoldersGrid" Grid.Row="1" Margin="20,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Pinned"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource BarTextSecondary}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ItemsRepeater x:Name="PinnedRepeater" Grid.Row="1">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="88"
                                                   MinItemHeight="98"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:PinnedApp">
                                    <Button Style="{StaticResource PinnedTileButtonStyle}"
                                            Width="88"
                                            Height="98"
                                            DataContext="{x:Bind}"
                                            Click="PinnedTile_Click"
                                            RightTapped="App_RightTapped"
                                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                        <StackPanel Spacing="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Image Source="{x:Bind IconSource, Mode=OneWay}"
                                                   Width="32"
                                                   Height="32"
                                                   HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource BarTextPrimary}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Footer -->
                        <Border Grid.Row="2"
                                Margin="20,12,20,16"
                                CornerRadius="12"
                                Background="{ThemeResource BarPillStroke}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Machitan"
                                           FontSize="11"
                                           Foreground="{ThemeResource BarTextTertiary}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button x:Name="SettingsButton"
                                            Style="{StaticResource ShellFooterButtonStyle}"
                                            Click="Settings_Click"
                                            ToolTipService.ToolTip="Machitan settings"
                                            AutomationProperties.Name="Machitan settings">
                                        <FontIcon Glyph="&#xE713;"
                                                  FontFamily="Segoe Fluent Icons"
                                                  FontSize="15"
                                                  Foreground="{ThemeResource BarTextSecondary}" />
                                    </Button>
                                    <Button x:Name="PowerButton"
                                            Style="{StaticResource ShellFooterButtonStyle}"
                                            ToolTipService.ToolTip="Power"
                                            AutomationProperties.Name="Power">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Sleep" Click="PowerSleep_Click" />
                                                <MenuFlyoutItem Text="Restart" Click="PowerRestart_Click" />
                                                <MenuFlyoutItem Text="Shut down" Click="PowerShutdown_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Sign out" Click="PowerSignOut_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <FontIcon Glyph="&#xE7E8;"
                                                  FontFamily="Segoe Fluent Icons"
                                                  FontSize="15"
                                                  Foreground="{ThemeResource BarTextSecondary}" />
                                    </Button>
                                    <Button Content="Exit"
                                            Style="{StaticResource ShellFooterButtonStyle}"
                                            FontSize="12"
                                            Foreground="{ThemeResource BarTextSecondary}"
                                            Padding="10,0"
                                            Click="Exit_Click"
                                            ToolTipService.ToolTip="Exit Machitan"
                                            AutomationProperties.Name="Exit Machitan" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>