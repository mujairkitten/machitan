# Let Git normalise line endings; keep Windows line endings in the working tree for source files.
* text=auto

*.cs       text eol=crlf diff=csharp
*.xaml     text eol=crlf
*.csproj   text eol=crlf
*.slnx     text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.manifest text eol=crlf
*.json     text eol=crlf
*.md       text eol=crlf
*.resx     text eol=crlf
*.iss      text eol=crlf
*.cmd      text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.gif  binary
*.ttf  binary
*.otf  binary
