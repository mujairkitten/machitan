<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Machitan</RootNamespace>
    <AssemblyName>Machitan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Machitan.exe's icon (File Explorer, shortcuts); windows get the same file through AppWindow.SetIcon. -->
    <ApplicationIcon>machitan.ico</ApplicationIcon>

    <!-- x64 and ARM64. A build follows Visual Studio's platform (x64 or ARM64);
         build-installer.cmd publishes each one with -r win-x64 or -r win-arm64. -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' != 'win-arm64'">x64</PlatformTarget>

    <!-- WinUI 3, unpackaged, self-contained (.NET and Windows App SDK both ship with the app).
         build-installer.cmd also publishes a Trimmed edition without .NET (self-contained false). -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Program.cs owns Main (the guardian process in Batch 1 needs it). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <Product>Machitan</Product>
    <Description>Alternative modern shell for Windows 11</Description>
    <Version>0.9.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The parts of the Windows App SDK Machitan uses: WinUI 3 (it brings Foundation, InteractiveExperiences
         and WebView2 with it) and the runtime declaration. Not the all-in-one Microsoft.WindowsAppSDK package,
         which also carries AI, ML, Search, Widgets and DWriteCore (about 62 MB that Machitan never uses).
         Agreed with Sam, 2026-11-20. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.7.0" />
    <!-- WMI: the laptop screen's brightness in quick settings (Win+A). Agreed with Sam, 2026-11-17. -->
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Machitan's text: Strings.resx (English) and one Strings.xx.resx per translation (see TRANSLATING.md). -->
    <EmbeddedResource Update="Translations\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
      <CustomToolNamespace>Machitan</CustomToolNamespace>
    </EmbeddedResource>
    <Compile Update="Translations\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Next to Machitan.exe, for AppWindow.SetIcon (the window's taskbar and Alt+Tab icon). -->
    <None Remove="machitan.ico" />
    <Content Include="machitan.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
