<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Machitan</RootNamespace>
    <AssemblyName>Machitan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- x64 only. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- WinUI 3, unpackaged, self-contained (.NET and Windows App SDK both ship with the app). -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Program.cs owns Main (the guardian process in Batch 1 needs it). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <Product>Machitan</Product>
    <Description>Alternative modern shell for Windows 11</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <!-- WMI: the laptop screen's brightness in quick settings (Win+A). Agreed with Sam, 2026-11-17. -->
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
