<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Machitan.SeeThroughTestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Machitan - see-through test">

    <!-- The root has no fill on purpose: everything outside the three shapes should be see-through. -->
    <Grid x:Name="Root" RequestedTheme="Dark">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="28">

            <!-- 1: a plain solid capsule -->
            <Border
                x:Name="SolidCapsule"
                Height="64"
                Padding="24,0,24,0"
                VerticalAlignment="Center"
                Background="#FF202020"
                CornerRadius="32">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Text="1 - solid capsule" />
                    <Button
                        AutomationProperties.Name="Close the test"
                        Click="OnCloseClicked"
                        Content="Close" />
                </StackPanel>
            </Border>

            <!-- 2: an acrylic capsule -->
            <Grid
                x:Name="AcrylicHost"
                Width="200"
                Height="64"
                VerticalAlignment="Center">
                <SystemBackdropElement x:Name="AcrylicCapsule" CornerRadius="32" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="2 - acrylic capsule" />
            </Grid>

            <!-- 3: a rounded box with the switches -->
            <Border
                x:Name="SwitchBox"
                Padding="20,10,20,10"
                VerticalAlignment="Center"
                Background="#FF202020"
                CornerRadius="16">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ToggleSwitch
                        x:Name="BackdropToggle"
                        MinWidth="0"
                        AutomationProperties.Name="A: see-through backdrop"
                        Header="A: see-through backdrop"
                        IsOn="True"
                        Toggled="OnOptionToggled" />
                    <ToggleSwitch
                        x:Name="DwmAlphaToggle"
                        MinWidth="0"
                        AutomationProperties.Name="B: Windows alpha"
                        Header="B: Windows alpha"
                        IsOn="True"
                        Toggled="OnOptionToggled" />
                    <ToggleSwitch
                        x:Name="LayeredToggle"
                        MinWidth="0"
                        AutomationProperties.Name="C: layered window"
                        Header="C: layered window"
                        IsOn="False"
                        Toggled="OnOptionToggled" />
                    <ToggleSwitch
                        x:Name="ClickThroughToggle"
                        MinWidth="0"
                        AutomationProperties.Name="D: click-through gaps"
                        Header="D: click-through gaps"
                        IsOn="False"
                        Toggled="OnOptionToggled" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
