<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Machitan.Start.StartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Machitan Start">

    <!--
        Floating boxes on a see-through window: the gaps between the boxes show the wallpaper.
        Each box gets its fill (acrylic or translucent colour) inserted in code, behind its content.
        The 4 DIP padding keeps the window's edge outside the cut, like the bar.
        Top: the user's box (greeting, folders, power). Left: search over the pinned
        categories. Right: All apps (Most used, then A to Z under clickable letters).
    -->
    <Grid
        x:Name="Root"
        Padding="4"
        Background="Transparent"
        KeyDown="OnRootKeyDown">
        <Grid x:Name="Layout" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="376" />
                <ColumnDefinition Width="276" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  The user's box: picture and greeting, the folder buttons, power  -->
            <Grid x:Name="UserStrip" Grid.ColumnSpan="2">
                <Grid Padding="8,0,10,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Opens Windows' Settings at Accounts > Your info.  -->
                    <Button
                        x:Name="UserButton"
                        Padding="6,4,12,4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Account settings"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnUserClicked"
                        CornerRadius="10"
                        ToolTipService.ToolTip="Account settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PersonPicture
                                x:Name="Avatar"
                                Width="32"
                                Height="32" />
                            <TextBlock
                                x:Name="UserName"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <!--  Folder buttons chosen in Settings > Start, as in Windows' Start > Folders.  -->
                    <StackPanel
                        x:Name="FolderPanel"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2" />
                    <StackPanel
                        x:Name="PowerPanel"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6" />
                    <Button
                        x:Name="PowerButton"
                        Grid.Column="2"
                        Width="36"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Power"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnPowerClicked"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Power">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="16"
                            Glyph="&#xE7E8;" />
                    </Button>
                </Grid>
            </Grid>

            <!--  Left column: search over the pinned categories  -->
            <Grid
                Grid.Row="1"
                Grid.Column="0"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="SearchBox" Grid.Row="0">
                    <Grid Padding="14,0,6,0" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="14"
                            Glyph="&#xE721;"
                            Opacity="0.7" />
                        <TextBox
                            x:Name="SearchInput"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Search apps, or type files: to search files"
                            KeyDown="OnSearchKeyDown"
                            PlaceholderText="Search apps (files: for files)"
                            TextChanged="OnSearchTextChanged" />
                    </Grid>
                </Grid>

                <!--  Pinned apps in their categories; while searching files, the file's preview takes its place.  -->
                <Grid x:Name="PinnedBox" Grid.Row="1">
                    <Grid
                        x:Name="PinnedContent"
                        Padding="12,12,12,12"
                        RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  Shown only while searching: the matching pins, best first, without categories.  -->
                        <TextBlock
                            x:Name="PinnedHeader"
                            Margin="4,0,0,0"
                            CharacterSpacing="60"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.75"
                            Text="PINNED"
                            Visibility="Collapsed" />
                        <ScrollViewer
                            x:Name="PinnedScroller"
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel x:Name="PinnedGroups" Spacing="10" />
                                <VariableSizedWrapGrid
                                    x:Name="PinnedPanel"
                                    ItemHeight="92"
                                    ItemWidth="88"
                                    MaximumRowsOrColumns="4"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock
                            x:Name="PinnedEmpty"
                            Grid.Row="1"
                            Margin="4,0,4,0"
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </Grid>
                    <Grid x:Name="PreviewHost" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!--  Right column: All apps (or file results); the letters' grid takes the list's place when a letter is clicked  -->
            <Grid
                x:Name="AppsBox"
                Grid.Row="1"
                Grid.Column="1">
                <Grid Padding="8,12,8,8" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="AppsHeader"
                        Margin="8,0,0,0"
                        CharacterSpacing="60"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="ALL APPS" />
                    <ScrollViewer
                        x:Name="AppsScroller"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="MostUsedHost" Visibility="Collapsed" />
                            <StackPanel x:Name="AppsPanel" Spacing="2" />
                            <StackPanel
                                x:Name="FilesPanel"
                                Spacing="2"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid
                        x:Name="LetterGrid"
                        Grid.Row="1"
                        Padding="4"
                        ColumnSpacing="4"
                        RowSpacing="4"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="AppsEmpty"
                        Grid.Row="1"
                        Margin="8,0,4,0"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>

        <!--  While an app is dragged: its copy under the pointer, and the line where it would go.  -->
        <Canvas x:Name="DragCanvas" IsHitTestVisible="False" />
    </Grid>
</Window>
