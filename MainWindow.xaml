<Window
    x:Class="Machitan.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machitan"
    Title="Machitan">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="PillBorder"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource BarPillStroke}"
                Background="Transparent">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Task Manager" Click="TaskManager_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Taskbar settings" Click="SettingsButton_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit Machitan" Click="Exit_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>
            <Grid Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: weather cluster (icon + real temp/condition text,
                     fed by WeatherService; text stays hidden until real
                     data arrives — never placeholder values) -->
                <StackPanel x:Name="WeatherCluster"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="2,0,8,0"
                            VerticalAlignment="Center">
                    <FontIcon x:Name="WeatherIcon"
                              Glyph="&#xE753;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="18"
                              Foreground="{ThemeResource BarAccent}"
                              VerticalAlignment="Center" />
                    <StackPanel x:Name="WeatherTextStack"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="WeatherText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource BarTextPrimary}" />
                        <TextBlock x:Name="WeatherConditionText"
                                   FontSize="10"
                                   Foreground="{ThemeResource BarTextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Start + Search + Task View + running apps
                     (the Build 28000 walkthrough's center cluster) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="StartButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Click="StartButton_Click"
                            ToolTipService.ToolTip="Start"
                            AutomationProperties.Name="Start">
                        <FontIcon Glyph="&#xE700;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="18"
                                  Foreground="{ThemeResource BarAccent}" />
                    </Button>

                    <Button x:Name="SearchButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Click="SearchButton_Click"
                            ToolTipService.ToolTip="Search"
                            AutomationProperties.Name="Search">
                        <FontIcon Glyph="&#xE721;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="16"
                                  Foreground="{ThemeResource BarTextPrimary}" />
                    </Button>

                    <Button x:Name="TaskViewButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Click="TaskViewButton_Click"
                            ToolTipService.ToolTip="Task view"
                            AutomationProperties.Name="Task view">
                        <FontIcon Glyph="&#xE7C4;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="16"
                                  Foreground="{ThemeResource BarTextPrimary}" />
                    </Button>

                    <Rectangle Width="1"
                               Height="22"
                               Fill="{ThemeResource BarDivider}"
                               Margin="3,0" />

                    <ItemsRepeater x:Name="TaskRepeater"
                                   VerticalAlignment="Center">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:TaskWindowItem">
                                <Button Style="{StaticResource BarTaskButtonStyle}"
                                        Width="{x:Bind local:MainWindow.GetTaskButtonWidth(), Mode=OneTime}"
                                        Height="{x:Bind local:MainWindow.GetTaskButtonHeight(), Mode=OneTime}"
                                        DataContext="{x:Bind}"
                                        Click="TaskButton_Click"
                                        RightTapped="TaskButton_RightTapped"
                                        ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                    <Grid Width="{x:Bind local:MainWindow.GetTaskButtonWidth(), Mode=OneTime}"
                                          Height="{x:Bind local:MainWindow.GetTaskButtonHeight(), Mode=OneTime}">
                                        <!-- Pill highlight behind the active app -->
                                        <Border CornerRadius="10"
                                                Background="{ThemeResource BarTileHover}"
                                                Visibility="{x:Bind local:BoolToVisibilityConverter.ToVis(IsActive), Mode=OneWay}" />
                                        <Image Source="{x:Bind IconSource, Mode=OneWay}"
                                               Width="{x:Bind local:MainWindow.GetTaskIconSize(), Mode=OneTime}"
                                               Height="{x:Bind local:MainWindow.GetTaskIconSize(), Mode=OneTime}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-4,0,0" />
                                        <!-- Running indicator: accent bar when
                                             focused, grey bar when not -->
                                        <Border Width="16"
                                                Height="3"
                                                CornerRadius="1.5"
                                                Background="{ThemeResource BarTextTertiary}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,4"
                                                Visibility="{x:Bind local:BoolToVisibilityConverter.ToVisInverse(IsActive), Mode=OneWay}" />
                                        <Border Width="16"
                                                Height="3"
                                                CornerRadius="1.5"
                                                Background="{ThemeResource BarAccent}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,4"
                                                Visibility="{x:Bind local:BoolToVisibilityConverter.ToVis(IsActive), Mode=OneWay}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Right: quick-settings pill (volume + network), battery,
                     clock (time over date), notifications, settings -->
                <StackPanel x:Name="TrayCluster"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button x:Name="QuickSettingsButton"
                            Height="36"
                            Padding="12,0"
                            CornerRadius="8"
                            Background="{ThemeResource BarSearchFill}"
                            BorderThickness="0"
                            Click="QuickSettings_Click"
                            ToolTipService.ToolTip="Quick settings"
                            AutomationProperties.Name="Quick settings">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE767;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="14"
                                      Foreground="{ThemeResource BarTextPrimary}" />
                            <FontIcon Glyph="&#xE701;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="14"
                                      Foreground="{ThemeResource BarTextPrimary}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BatteryButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Width="Auto"
                            Padding="8,0"
                            Click="QuickSettings_Click"
                            ToolTipService.ToolTip="Battery"
                            AutomationProperties.Name="Battery"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon x:Name="BatteryIcon"
                                      Glyph="&#xE850;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="16"
                                      Foreground="{ThemeResource BarTextPrimary}" />
                            <TextBlock x:Name="BatteryText"
                                       FontSize="11"
                                       Foreground="{ThemeResource BarTextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1"
                               Height="20"
                               Fill="{ThemeResource BarDivider}"
                               Margin="4,0" />

                    <Button x:Name="ClockButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Width="88"
                            Click="Calendar_Click"
                            ToolTipService.ToolTip="Calendar and notifications"
                            AutomationProperties.Name="Clock, calendar and notifications">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText"
                                       Text="--:--"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource BarTextPrimary}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="DateText"
                                       Text="---"
                                       FontSize="10"
                                       Foreground="{ThemeResource BarTextSecondary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NotificationButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Click="Notification_Click"
                            ToolTipService.ToolTip="Notifications"
                            AutomationProperties.Name="Notifications">
                        <FontIcon Glyph="&#xE7E7;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="16"
                                  Foreground="{ThemeResource BarTextSecondary}" />
                    </Button>

                    <Button x:Name="SettingsButton"
                            Style="{StaticResource BarIconButtonStyle}"
                            Click="SettingsButton_Click"
                            ToolTipService.ToolTip="Machitan settings"
                            AutomationProperties.Name="Machitan settings">
                        <FontIcon Glyph="&#xE713;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="16"
                                  Foreground="{ThemeResource BarTextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
