<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Machitan.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Machitan - Batch 0 backdrop proof">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- No Background on the root by default: a fill here would cover the window backdrop. -->
    <Grid x:Name="Root" RequestedTheme="Dark" Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Batch 0 - backdrop proof" />

        <TextBlock
            Grid.Row="1"
            TextWrapping="Wrap"
            Text="Keep something colourful behind this window. Pick a test, keep the slider at 0, and look for a clear blur of what is behind. Black or one flat colour means that test fails." />

        <ComboBox
            x:Name="ModeBox"
            Grid.Row="2"
            MinWidth="460"
            AutomationProperties.Name="Backdrop test"
            Header="Test"
            SelectedIndex="0"
            SelectionChanged="OnModeChanged">
            <ComboBoxItem Content="1 - Window: stock DesktopAcrylicBackdrop" />
            <ComboBoxItem Content="2 - Window: Machitan acrylic (uses the slider)" />
            <ComboBoxItem Content="3 - Window: Mica (tinted wallpaper, no live blur)" />
            <ComboBoxItem Content="4 - Rounded box: Machitan acrylic inside the window (uses the slider)" />
        </ComboBox>

        <Slider
            x:Name="TintSlider"
            Grid.Row="3"
            AutomationProperties.Name="Tint strength"
            Header="Tint strength (0 = blur only, 100 = solid)"
            IsEnabled="False"
            Maximum="100"
            Minimum="0"
            StepFrequency="5"
            ValueChanged="OnTintChanged"
            Value="0" />

        <ToggleSwitch
            x:Name="ForceHostToggle"
            Grid.Row="4"
            AutomationProperties.Name="Ask Windows for the host backdrop directly"
            Header="Ask Windows for the host backdrop directly (DWM attribute 17)"
            OffContent="Off"
            OnContent="On"
            Toggled="OnForceHostToggled" />

        <Grid
            x:Name="BoxHost"
            Grid.Row="5"
            Width="460"
            Height="110"
            HorizontalAlignment="Left"
            Visibility="Collapsed">
            <SystemBackdropElement x:Name="BoxBackdrop" CornerRadius="28" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Rounded acrylic box" />
        </Grid>

        <StackPanel Grid.Row="6" Spacing="6" VerticalAlignment="Bottom">
            <TextBlock x:Name="BackdropLine" TextWrapping="Wrap" />
            <TextBlock x:Name="HostLine" TextWrapping="Wrap" />
            <TextBlock x:Name="FocusLine" TextWrapping="Wrap" />
            <TextBlock x:Name="SupportLine" TextWrapping="Wrap" />
            <TextBlock x:Name="EffectsLine" TextWrapping="Wrap" />
            <TextBlock x:Name="EnergyLine" TextWrapping="Wrap" />
            <TextBlock x:Name="VersionLine" TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Window>
